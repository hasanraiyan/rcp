{
  "name": "rcp-sdk",
  "version": "0.2.0",
  "description": "Reference SDK for RCP (REST Connector Protocol) — a lightweight, open protocol for exposing REST APIs as AI-callable tools.",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js",
      "require": "./dist/adapters/langchain.cjs"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js",
      "require": "./dist/adapters/openai.cjs"
    },
    "./adapters/gemini": {
      "types": "./dist/adapters/gemini.d.ts",
      "import": "./dist/adapters/gemini.js",
      "require": "./dist/adapters/gemini.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "rcp",
    "rest-connector-protocol",
    "rcp-sdk",
    "mcp-alternative",
    "build-ai-agent",
    "ai-agent",
    "rest-api-to-ai-agent",
    "rest-api-to-ai",
    "llm-tool-calling",
    "openai-function-calling",
    "langchain",
    "langchain-tools",
    "gemini-function-calling",
    "ai-tools",
    "rest-api",
    "agent-protocol"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hasanraiyan/rcp/tree/master/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanraiyan/rcp.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/hasanraiyan/rcp/issues"
  },
  "sideEffects": false,
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^0.3.72",
    "@types/node": "^22.10.7",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
