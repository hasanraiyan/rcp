{
  "name": "rcp-sdk",
  "version": "0.1.0",
  "description": "Reference SDK for RCP (REST Connector Protocol) — a lightweight, open protocol for exposing REST APIs as AI-callable tools.",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic/run.ts"
  },
  "keywords": [
    "rcp",
    "rest-connector-protocol",
    "ai",
    "agents",
    "tools",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hasanraiyan/rcp/tree/master/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanraiyan/rcp.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/hasanraiyan/rcp/issues"
  },
  "sideEffects": false,
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
